---
const newsItems = [
  '🚀 أعلنت شركة مايكروسوفت عن إطلاق منصة جديدة للتعلم بالذكاء الاصطناعي لتسريع التطور التكنولوجي في القطاع التعليمي.',
  '🤖 تم تطوير روبوت جديد باستخدام الذكاء الاصطناعي يمكنه أداء مهام复杂ة في مجال الصناعة بشكل أسرع وأكثر دقة.',
  '📊 استخدمت شركة أمازون الذكاء الاصطناعي لتحسين خدمات التوصيل السريع وتقليل وقت التسليم إلى النصف في العديد من المدن حول العالم.',
  '📚 تم تطوير نظام جديد باستخدام الذكاء الاصطناعي يمكنه ترجمة اللغات بدرجة عالية من الدقة وتحسين فهم النصوص المعقدة.',
  '💻 أعلنت شركة جوجل عن إطلاق أداة جديدة للكشف الآلي عن الأخطاء البرمجية باستخدام الذكاء الاصطناعي لتحسين أمان وتطوير البرمجيات.',
];
---

<div class="news-ticker">
  <div class="ticker-label">🔴 عاجل</div>
  <div class="ticker-track">
    <div class="ticker-inner">
      {newsItems.map((item) => <span>{item}</span>)}
      {newsItems.map((item) => <span>{item}</span>)}
    </div>
  </div>
</div>
