---
const newsItems = [
  '🤖 شركة تقنية كبرى تعلن عن تطوير نظام ذكاء اصطناعي لمساعدة الأشخاص ذوي الإعاقة في التفاعل مع التطبيقات الرقمية بسهولة أكبر.',
  '📊 تقرير حديث يُظهر تزايداً في استخدام الذكاء الاصطناعي في مجال الصحة لتحليل البيانات الطبية وتحسين التشخيص.',
  '🚀 باحثون ينجحون في تطوير خوارزمية ذكاء اصطناعي جديدة تتيح تحليل بيانات الفضاء بسرعة و دقة عالية.',
  '💻 شركة تكنولوجيا تعلن عن إطلاق منصة تعليمية تعتمد على الذكاء الاصطناعي لتوفير تجارب تعلم تفاعلية للمستخدمين.',
  '📈 دراسة حديثة تُظهر أن استخدام الذكاء الاصطناعي في قطاع الأعمال يمكن أن يزيد من الإنتاجية و يقلل من التكاليف التشغيلية.',
];
